# Keep PATH entries unique, including additions from optional integrations.
typeset -U path PATH
path=("$HOME/.local/bin" $path)
[[ -d "$HOME/.opencode/bin" ]] && path=("$HOME/.opencode/bin" $path)
export PATH

# Supply a Unicode default only when LANG is missing. LC_ALL and individual
# LC_* overrides keep their normal precedence; no system locales are generated.
if [[ -z ${LANG:-} ]]; then
  export LANG=C.UTF-8
fi

# Optional Google Cloud SDK installation.
if [[ -r "$HOME/google-cloud-sdk/path.zsh.inc" ]]; then
  source "$HOME/google-cloud-sdk/path.zsh.inc"
fi

# Use Starship when installed; otherwise keep the usual Oh My Zsh theme.
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="robbyrussell"
if (( $+commands[starship] )); then
  ZSH_THEME=""
fi
plugins=(git)

# A usable prompt even when Oh My Zsh and Starship are not installed yet.
PROMPT='%n@%m:%~%# '
if [[ -r "$ZSH/oh-my-zsh.sh" ]]; then
  source "$ZSH/oh-my-zsh.sh"
fi
ZLE_RPROMPT_INDENT=0

if (( $+commands[starship] )); then
  eval "$(starship init zsh)"
fi

# Load SDK completion after Oh My Zsh's completion setup.
if [[ -r "$HOME/google-cloud-sdk/completion.zsh.inc" ]]; then
  source "$HOME/google-cloud-sdk/completion.zsh.inc"
fi

# Prefer Neovim for local and remote sessions.
if (( $+commands[nvim] )); then
  export EDITOR='nvim'
else
  export EDITOR='vi'
fi

# Machine-specific settings and aliases take precedence over these defaults.
if [[ -r "$HOME/.zshrc.local" ]]; then
  source "$HOME/.zshrc.local"
fi
